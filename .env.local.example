# Firebase project settings, for cloud backup.
#
# Copy this file to .env.local for local development. These values are not
# secrets — they ship inside the built JavaScript of any web app and identify
# the project rather than authorising anything. What protects the data is
# firestore.rules, which only lets a signed-in user reach their own documents.
#
# Find them in Firebase Console → Project settings → General → Your apps →
# SDK setup and configuration → Config.
#
# Leave them unset and the app still runs: cloud backup is hidden and the
# ledger stays on the device, exactly as it did before sync existed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
